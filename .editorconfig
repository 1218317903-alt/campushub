# ============================================================
# CampusHub AI — 编辑器统一配置
# 目的：让不同编辑器/IDE 产出格式一致的代码，减少无意义的 diff
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 140

# ---------- Java ----------
[*.java]
indent_size = 4
max_line_length = 160

# ---------- XML / POM ----------
[*.{xml,pom,xsd,wsdl}]
indent_size = 2

# ---------- YAML ----------
[*.{yml,yaml}]
indent_size = 2

# ---------- SQL ----------
[*.sql]
indent_size = 2

# ---------- Markdown：保留行尾空格（Markdown 用两空格换行）----------
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# ---------- 前端 ----------
[*.{js,ts,jsx,tsx,vue,json,css,scss,html}]
indent_size = 2
max_line_length = 120

# ---------- Shell ----------
[*.{sh,bash,zsh}]
indent_size = 2

# ---------- Makefile 必须用 Tab ----------
[Makefile]
indent_style = tab
indent_size = 4
