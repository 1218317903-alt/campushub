<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==========================================================================
  CampusHub AI — 后端工程（Phase 01）
  ==========================================================================
  版本依据（全部经 Maven Central 实测，见 docs/11-开发环境.md 6bis 节与
  00-工程规约.md 3.4 节，不得凭记忆修改）：

    Spring Boot        4.1.1   [当前维护主线，3.5 线最后补丁 2026-06-25，已在末段]
    Spring Framework   7.0.9   [由 Boot 4.1.1 管理]
    Spring Security    7.1.1   [由 Boot 4.1.1 管理，Phase 02 使用]
    Web Starter        spring-boot-starter-webmvc
                                Boot 4 中 spring-boot-starter-web 已弃用，
                                官方 description 明确 deprecated in favor of
                                spring-boot-starter-webmvc
    数据访问           官方 MyBatis 4.1.0
                                不用 MyBatis-Plus：其仅提供
                                mybatis-plus-spring-boot3-starter，BOM 导入
                                spring-boot-dependencies:3.5.9，无 Boot 4 支持
    Flyway             12.4.0  [由 Boot 4.1.1 管理，需 flyway-core + flyway-mysql]
    MySQL 驱动         9.7.0   [由 Boot 4.1.1 管理]
    Testcontainers     2.0.5   [由 Boot 4.1.1 管理]
                                构件名已变更为 testcontainers-mysql /
                                testcontainers-junit-jupiter（2.x 命名）
    API 文档           springdoc-openapi 3.1.1 [Boot 4 线，2.9.1 属 Boot 3.5 线]
    ArchUnit           1.5.0   [不在 Boot 管理范围内，显式指定]

  模块形态：单 Maven 模块 + 包级模块边界（ArchUnit 强制）。
            见 docs/adr/0001-modular-monolith.md 的决策与拆分触发条件。
  ==========================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>ai.camphub</groupId>
  <artifactId>camphub</artifactId>
  <!-- 版本号是**单一来源**：application.yml 通过资源过滤 @project.version@ 引用它，
       /api/v1/system/info 也由此取数。改动这里即改动全项目对外报出的版本，
       不允许在 yml、前端或代码里再写一份。
       发布态不带 -SNAPSHOT；下一次开发的开发态再改为下一版本的 -SNAPSHOT。 -->
  <version>0.5.1</version>
  <packaging>jar</packaging>

  <name>CampusHub AI</name>
  <description>面向高校学生及年轻学习者的 AI 知识协作、内容社区与智能信息发现平台</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 非 Boot 管理范围的依赖版本集中在此，禁止散落各处 -->
    <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
    <springdoc.version>3.1.1</springdoc.version>
    <archunit.version>1.5.0</archunit.version>
    <commonmark.version>0.30.0</commonmark.version>
    <html-sanitizer.version>20260313.1</html-sanitizer.version>
    <!-- Phase 05：Boot 4.1.1 的 spring-boot-dependencies **不托管**下面两个，
         版本经 Maven Central 实测后在此显式钉死（详见 00-工程规约.md 3.4）。 -->
    <pdfbox.version>3.0.7</pdfbox.version>
    <awssdk.version>2.46.7</awssdk.version>
  </properties>

  <dependencies>

    <!-- ========== Web ========== -->
    <!-- 注意：Boot 4 使用 webmvc，不是已弃用的 web -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- ========== 参数校验 ========== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ========== 健康检查 / 指标端点 ========== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ========== 数据访问 ========== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis-spring-boot.version}</version>
    </dependency>

    <!-- ========== 数据库迁移 ========== -->
    <!--
      为什么必须显式引入 spring-boot-starter-flyway：
      Boot 4 把 Flyway 的自动配置从 spring-boot-autoconfigure 拆到了独立构件
      spring-boot-flyway / spring-boot-starter-flyway。
      只放 flyway-core 而不放这个 starter 时，Flyway 的 auto-configuration 不会被加载，
      结果是**迁移静默不执行**：应用能正常启动、接口能返回，但表根本不存在。
      实测证据：集成测试报 "Table 'camphub.app_metadata' doesn't exist"，
      且 spring-boot-autoconfigure:4.1.1 中已不存在任何 flyway 相关类。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- MySQL 方言支持单独成构件，缺了它 Flyway 无法识别 MySQL -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- ========== MySQL 驱动（版本由 Boot 管理） ========== -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ========== 认证与授权（Phase 02） ========== -->
    <!--
      只引 spring-security-oauth2-jose，不引 spring-boot-starter-oauth2-resource-server。
      理由：
        1. resource-server starter 面向「校验由外部授权服务器签发的 Token」这一场景，
           会带来 BearerTokenAuthenticationFilter、JwtAuthenticationConverter 等一整套
           约定，以及自己的自动配置分支。本项目的令牌由自己签发，且必须在签名校验之外
           再查一次 user.token_version（撤销语义），所以鉴权过滤器本来就要自己写 ——
           引 starter 只会多出两条并行、只有一条真正生效的链路。
        2. 本模块实际需要的只有 NimbusJwtEncoder / NimbusJwtDecoder / JwtClaimsSet，
           它们都在 spring-security-oauth2-jose 里，nimbus-jose-jwt 随之传入。
      版本不显式声明：spring-security-* 全部由 Boot 4.1.1 导入的 spring-security-bom 管理。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>

    <!-- ========== Markdown 渲染与 HTML 净化（Phase 03） ========== -->
    <!--
      为什么 Markdown 在服务端渲染：帖子正文是用户提交的富文本，Markdown → HTML
      是一道**安全边界**。放在服务端意味着这条边界只有一处实现、一处审查；
      放到客户端则意味着每个客户端都要各自记得净化，漏一个就是一个存储型 XSS 入口。
      另外服务端渲染一次、连同原文一起入库，读路径（列表 + 详情）就完全不需要再渲染。

      为什么同时引"转换器"和"净化器"两个库（而不是只引一个）：
        · commonmark 是转换器。配置 escapeHtml=true 后，用户写的原始 HTML 会被转义输出，
          但它只覆盖"用户直接塞的标签"这一条路径。
        · OWASP java-html-sanitizer 是**基于白名单的独立第二道**。它的价值在于
          "转换器出 bug 时，输出仍然被限制在允许的标签/属性集合内" ——
          两个独立实现同时出同一个洞的概率远低于一个实现出洞的概率。
        · 代价很小：净化器不带 guava 之类的大依赖，只有它自己的两个 shim。
      刻意**不**引 commonmark-ext-autolink 等扩展：每多一个扩展就多一处
      链接/属性注入面，而当前内容体裁用不到它们。
    -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <!-- GFM 表格：技术类长文里表格是常规表达方式，缺了它作者的排版会被整段吞掉 -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-tables</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <dependency>
      <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
      <artifactId>owasp-java-html-sanitizer</artifactId>
      <version>${html-sanitizer.version}</version>
    </dependency>

    <!-- ========== PDF 解析（Phase 05） ========== -->
    <!--
      为什么是 PDFBox 而不是别的：
        · Apache 2.0，无 AGPL/商业授权牵连（iText 是 AGPL，商用需买授权）。
        · 只解析、不渲染 —— 本阶段只需要把正文抽成文本，不需要把页面画出来。
          iText / OpenPDF 的排版能力在这里是零收益的重量。
        · 传递依赖很小（fontbox + pdfbox-io，都是同一项目），
          不像某些 PDF 库会拖进一整套 IO/图形栈。

      为什么显式钉版本：Boot 4.1.1 的 spring-boot-dependencies 里没有 pdfbox，
      不写版本会导致构建失败（而不是悄悄用某个版本）。3.0.7 是 Maven Central 实测的最新。

      为什么用 3.x 而不是还在维护的 2.0.36：
        3.x 把加载入口从静态方法 PDDocument.load 改成了 Loader.loadPDF，
        并且可以传 MemoryUsageSetting 限制解析期内存 —— 后者是本项目需要的
        （PDF 是用户上传的不可信输入，见 docs/document-pipeline.md 的解析安全一节）。
    -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>

    <!-- ========== S3 兼容对象存储（Phase 05，可选后端） ========== -->
    <!--
      为什么用 AWS SDK v2 而不是 MinIO 官方 Java SDK：
        · io.minio:minio 最后一个发布是 8.5.17（2025-01），此后无更新，已进维护模式；
          AWS SDK v2 同期仍在按月发布（本版本 2.46.7 为 2026-06）。
          选一个还在被维护的客户端，不是选一个"更贴近 MinIO"的客户端 —— MinIO 本身
          就实现了 S3 协议，用 S3 的标准客户端访问它正是它的设计意图。
        · 因此本项目的 S3 适配器对 MinIO、AWS S3、以及其他 S3 兼容实现是同一份代码，
          差别只在 endpoint 与 path-style 两个配置项。

      为什么额外引 url-connection-client，并排除另外两个：
        AWS SDK 的 HTTP 实现是可插拔的，而 s3 构件把可选项全部当依赖带了进来。
        实测（mvn dependency:tree）：不排除时 runtime 里会同时出现 apache5-client、
        netty-nio-client 以及它们各自的传递依赖树。真正生效的只有我们显式装配的那一个，
        其余全是构建产物里永不执行的重量。
        选 url-connection-client 而不是它们的理由：它只依赖 JDK，不引入任何
        HTTP 客户端版本，因此不可能与 Boot 管理的 HttpClient / Netty 版本发生冲突；
        而本项目的对象存储调用是低频、大 body、同步的，用不上连接池调优或多路复用。

      为什么版本必须显式写：同 pdfbox，Boot BOM 不托管 software.amazon.awssdk。
      注意 SDK 自带的 JSON 支持是重打包的（software.amazon.awssdk.thirdparty.jackson），
      与项目使用的 Jackson 3（tools.jackson）包名不重叠，不存在版本竞争。
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${awssdk.version}</version>
      <!--
        必须显式排除这两个 HTTP 实现（实测：s3 会把它们作为 runtime 依赖带入）。
        不排除的话，构建产物里会多出一整条 Netty 栈（netty-codec-http / http2 /
        compression / transport ...）与 Apache HttpClient 5 —— 而本项目一次都
        不会用它们：真正生效的 HTTP 客户端由下面 url-connection-client 提供。
        多一份永远不被实例化的 IO 栈，意味着多一份需要跟进安全公告的依赖。
      -->
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
      <version>${awssdk.version}</version>
    </dependency>

    <!-- ========== API 文档 ========== -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- ======================== 测试 ======================== -->

    <!-- JUnit 5 / AssertJ / Mockito -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Boot 4 拆分出的 WebMvc 测试支持（@WebMvcTest / MockMvc） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers：集成测试用真实 MySQL，不用 H2 顶替 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 架构边界测试：把「模块边界」从口头约定变成构建时断言 -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Testcontainers 说明：
        仓库内**不含**任何 testcontainers.properties —— 那是环境适配，不是项目配置，
        写进仓库会把所有克隆者钉死在某个 ryuk 版本上。
        本机（Docker Hub 不可达）把 ryuk 指向本地 tag，做法是用户级
        ~/.testcontainers.properties（见 docs/11-开发环境.md 7.2 节）。
        能直连 Docker Hub 的机器什么都不用配。
        MySQL 镜像固定为 mysql:8.4，在测试基类中以 withImage 指定（这是项目决定，
        因为它影响测试行为，与运行环境无关）。
      -->

      <!-- 集成测试（*IT）与单元测试（*Test）分阶段执行：
             mvn test    只跑单元测试
             mvn verify  先单元测试，再集成测试 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
