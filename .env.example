# ============================================================
# CampusHub AI — 环境变量样例
# ============================================================
# 用法：
#   cp .env.example .env        # 然后填入真实值
#
# 纪律（docs/00-工程规约.md §15.5）：
#   · .env 已被 .gitignore 忽略，**绝不入库**
#   · 不要把真实密码、Key、Token 写进本文件（本文件会被提交）
#   · 本文件只保留变量名与示例值
# ============================================================

# ---------- 运行配置 ----------
# ⚠️ 刻意不在此提供 SPRING_PROFILES_ACTIVE：
#    它会与集成测试的 @ActiveProfiles("test") 争夺 profile 决定权，导致测试行为不确定。
#    需要切换 profile 时，请在启动命令前直接给环境变量，例如：
#        SPRING_PROFILES_ACTIVE=prod java -jar app.jar
#    application.yml 中的默认值是 local。

# 后端 HTTP 端口
SERVER_PORT=8080

# ---------- 应用自己的配置 ----------
APP_NAME=camphub
# 应用版本号（会出现在 /api/v1/system/info）
APP_VERSION=0.1.0

# ---------- MySQL（应用连接用）----------
# 注意：本项目使用 MySQL 8.4。字符集必须 utf8mb4。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=camphub
MYSQL_USER=camphub
MYSQL_PASSWORD=change-me-app-password

# ---------- MySQL（docker compose 初始化用）----------
# 仅被 docker-compose.yml 读取，用于首次创建容器
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---------- JDBC 连接串（可选，留空则由上面变量拼接）----------
# 显式指定时区，避免时间衰减类排序出现时区错位（见 docs/11-开发环境.md §5.1）
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/camphub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

# ---------- 连接池 ----------
# 起步值保守，Phase 09 压测后再依据真实数据调整
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ---------- 后续阶段使用（当前 Phase 01 不读取，先占位以免遗漏）----------
# Redis（Phase 09 引入）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=change-me

# 对象存储（Phase 05 引入）
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=change-me
# MINIO_SECRET_KEY=change-me
# MINIO_BUCKET=camphub

# LLM（Phase 08 引入）
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=change-me

# ---------- 测试相关 ----------
# Testcontainers 使用的 MySQL 镜像（与本机已有的镜像保持一致，避免额外拉取）
TESTCONTAINERS_MYSQL_IMAGE=mysql:8.4
# 若 Docker Hub 不可达（本机即如此），把 ryuk 镜像指向本地已有的 tag 或镜像代理
# TESTCONTAINERS_RYUK_CONTAINER_IMAGE=testcontainers/ryuk:0.11.0
