<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.camphub.community.infrastructure.PostViewMapper">

    <!-- 这里用 INSERT IGNORE 是合适的（与 PostReactionMapper 的取舍相反）：
         "今天已经看过这条帖子"是**预期中的常态**，不表达任何异常，
         因此不需要让它以异常的形式进入调用方。影响行数（1 / 0）本身
         就精确地回答了"这是不是今天第一次看"。
         外键不存在的担忧不成立：调用方必然先成功读到了这条帖子。 -->
    <insert id="insertIfAbsent">
        INSERT IGNORE INTO post_view_daily (post_id, view_date, user_id)
        VALUES (#{postId}, #{viewDate}, #{userId})
    </insert>

</mapper>
